FROM ubuntu:22.04

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

ARG BINARY_PATH=target/release/xenom-miner
COPY ${BINARY_PATH} /usr/local/bin/xenom-miner
COPY scripts/miner-entrypoint.sh /usr/local/bin/xenom-miner-entrypoint.sh
RUN chmod +x /usr/local/bin/xenom-miner /usr/local/bin/xenom-miner-entrypoint.sh

WORKDIR /root/.xenom-miner

ENTRYPOINT ["/usr/local/bin/xenom-miner-entrypoint.sh"]
CMD []
