FROM ubuntu:22.04

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

ARG BINARY_PATH=target/release/xenom
COPY ${BINARY_PATH} /usr/local/bin/xenom
COPY scripts/node-entrypoint.sh /usr/local/bin/xenom-node-entrypoint.sh
RUN chmod +x /usr/local/bin/xenom /usr/local/bin/xenom-node-entrypoint.sh

EXPOSE 16110 16111 16112

ENTRYPOINT ["/usr/local/bin/xenom-node-entrypoint.sh"]
CMD []
