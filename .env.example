# Xenomorph AI Devnet Configuration
# Copy to .env and adjust as needed. Values are loaded by all scripts.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
XENO_VERSION=0.1.0
XENO_REGISTRY=
XENO_LOG_LEVEL=info
XENO_NETWORK=devnet
XENO_CHECKPOINT_HISTORY_SIZE=8
FEDAVG_MIN_PARTICIPANTS=4

# -----------------------------------------------------------------------------
# Gossip (P2P checkpoint metadata)
# -----------------------------------------------------------------------------
# Gossip keys are generated automatically when a node starts and are persisted
# under <datadir>/gossip.key (xenom-node) or <XENO_MODELS_DIR>/gossip.key
# (seed-node).  No manual configuration is required.

# -----------------------------------------------------------------------------

# Node
# -----------------------------------------------------------------------------
XENO_NODE_IMAGE=xeno-node
XENO_NODE_RPC_PORT=16110
XENO_NODE_P2P_PORT=16111
XENO_NODE_P2P=xeno-node:16111
# Hostname/IP advertised in checkpoint gossip for the seed-node (used when XENO_MINER_WS_ADDR binds to 0.0.0.0)
XENO_SEED_HOST=xeno-seed
XENO_MINER_RPC_PORT=17110
# The node also acts as the training coordinator / genome server for miners.
XENO_NODE_EXTRA_ARGS=--devnet --utxoindex --miner-ws-listen=0.0.0.0:17110

# -----------------------------------------------------------------------------
# Miner
# -----------------------------------------------------------------------------
XENO_MINER_IMAGE=xeno-miner
XENO_MINER_MODEL_ID=multimolecule/dnabert2
XENO_MINER_THREADS=4
XENO_MINER_RPC_PORT=17110
XENO_MINER_TRAINER=mock
XENO_MINER_EXTRA_ARGS=

# -----------------------------------------------------------------------------
# EVM / Governance / Payments (Anvil devnet)
# -----------------------------------------------------------------------------
XENO_ANVIL_IMAGE=ghcr.io/foundry-rs/foundry:stable
XENO_ANVIL_PORT=8545
XENO_FORK_URL=
XENO_BLOCK_TIME=12

# Contract addresses (populated automatically by test-governance-flow.sh if empty)
XENO_GOVERNANCE_ADDRESS=
XENO_PAYMENTS_ADDRESS=
XENO_USDT_ADDRESS=

# Test accounts derived from Anvil default mnemonic
XENO_FOUNDRY_MNEMONIC="test test test test test test test test test test test junk"
XENO_TEST_ACCOUNT_INDEX=1

# -----------------------------------------------------------------------------
# Stress Test
# -----------------------------------------------------------------------------
XENO_STRESS_MINERS=5
XENO_STRESS_DURATION=30m
XENO_STRESS_RPS=10
XENO_STRESS_REPORT_DIR=./reports

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
XENO_DATA_DIR=./devnet-data
XENO_COMPOSE_FILE=./docker-compose.devnet.yml
XENO_WALLET_PASSWORD=devnet-password
